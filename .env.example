# Copia este archivo como .env y completa los valores.

NODE_ENV=development
# Puerto de la API y de Socket.IO. docker-compose.yml también lo usa.
PORT=4000
# Origen del frontend permitido por CORS.
FRONTEND_URL=http://localhost:5173

# Supabase → Connect → Session pooler (puerto 5432).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API Keys.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# MediaMTX
MEDIAMTX_API_URL=http://127.0.0.1:9997
# Secreto compartido entre MediaMTX y el backend. Usa un valor aleatorio largo (mín. 32 caracteres).
MEDIAMTX_SECRET=cambia-esto-por-un-valor-aleatorio-largo
# Datos públicos para OBS y para el reproductor.
RTMP_PUBLIC_URL=rtmp://localhost:1935/live
HLS_PUBLIC_URL=http://localhost:8888
